{
  "name": "prooftoact-admissibility-memory",
  "version": "0.1.0",
  "packageManager": "npm@10.9.8",
  "private": true,
  "description": "Clean-room proof of admissibility memory for high-stakes agents.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "accessibility:browser": "\"$npm_node_execpath\" scripts/verify-browser-accessibility.js",
    "accessibility:verify": "\"$npm_node_execpath\" scripts/verify-accessibility.js",
    "brand:verify": "\"$npm_node_execpath\" scripts/verify-brand-migration.js",
    "build:gate2": "\"$npm_node_execpath\" scripts/build-gate2-exact.js",
    "claims:verify": "\"$npm_node_execpath\" scripts/verify-release-claims.js",
    "cost:verify": "\"$npm_node_execpath\" scripts/verify-release-cost.js",
    "dependencies:verify": "\"$npm_node_execpath\" scripts/verify-dependency-inventory.js",
    "licenses:verify": "\"$npm_node_execpath\" scripts/verify-bundled-third-party-notices.js",
    "generate:gate2": "\"$npm_node_execpath\" scripts/build-gate2-template.js --templates-only",
    "gate2:authority-race": "\"$npm_node_execpath\" scripts/gate2-authority-race.js",
    "gate2:integrated-live-drill": "\"$npm_node_execpath\" scripts/reject-direct-integrated-live-drill.js",
    "gate2:aws-preflight": "\"$npm_node_execpath\" scripts/gate2-aws-preflight.js",
    "gate2:aws-attest": "\"$npm_node_execpath\" scripts/gate2-aws-attestation.js",
    "gate2:aws-alternate-denial": "\"$npm_node_execpath\" scripts/gate2-evidence-operator-denial.js",
    "gate2:aws-readiness": "\"$npm_node_execpath\" scripts/gate2-aws-readiness.js",
    "gate2:aws-readiness:local": "\"$npm_node_execpath\" scripts/gate2-aws-readiness.js --local-only",
    "gate2:config-digest": "\"$npm_node_execpath\" scripts/gate2-config-digest.js",
    "gate2:verify-public-demo": "\"$npm_node_execpath\" scripts/gate2-public-demo-verify.js",
    "governance:verify": "\"$npm_node_execpath\" scripts/verify-release-governance.js",
    "demo": "\"$npm_node_execpath\" src/demo.js",
    "dev": "\"$npm_node_execpath\" src/server.js",
    "proof:verify": "\"$npm_node_execpath\" scripts/verify-proof-manifest.js",
    "privacy:verify": "\"$npm_node_execpath\" scripts/verify-release-privacy.js",
    "process-boundaries:verify": "\"$npm_node_execpath\" scripts/verify-integrated-live-drill-process-boundaries.js && \"$npm_node_execpath\" scripts/verify-integrated-live-drill-systemd-boundary.js",
    "rights:verify": "\"$npm_node_execpath\" scripts/verify-release-rights.js",
    "security:verify": "\"$npm_node_execpath\" scripts/verify-release-security.js",
    "submission:verify": "\"$npm_node_execpath\" scripts/verify-release-submission.js",
    "stress:provider-resume": "\"$npm_node_execpath\" scripts/run-integrated-live-drill-stress.js",
    "test:root-stage": "\"$npm_node_execpath\" --test test/root/integrated-live-drill-stage-root.test.js",
    "release:provenance": "\"$npm_node_execpath\" scripts/verify-release-provenance.js",
    "gate1:ambiguity": "\"$npm_node_execpath\" scripts/gate1-ambiguity.js",
    "gate1:ambiguity:full": "AMBIGUITY_RUNS=100 \"$npm_node_execpath\" scripts/gate1-ambiguity.js",
    "gate1:admissible-vector": "\"$npm_node_execpath\" scripts/gate1-admissible-vector.js",
    "gate1:admissible-vector:proof": "\"$npm_node_execpath\" scripts/gate1-admissible-vector.js --proof",
    "gate1:authority": "\"$npm_node_execpath\" scripts/gate1-authority.js",
    "gate1:authority:full": "RACE_RUNS=100 CONTENDERS=50 \"$npm_node_execpath\" scripts/gate1-authority.js",
    "full-drill:local": "\"$npm_node_execpath\" scripts/run-local-full-drills.js",
    "full-drill:local:verify": "\"$npm_node_execpath\" scripts/verify-local-full-drill-receipt.js",
    "gate1:capability-race": "\"$npm_node_execpath\" scripts/gate1-capability-race.js",
    "gate1:lease": "\"$npm_node_execpath\" scripts/gate1-lease.js",
    "gate1:provenance": "\"$npm_node_execpath\" scripts/gate1-provenance.js",
    "gate1:recovery": "\"$npm_node_execpath\" scripts/gate1-recovery.js",
    "gate1:recovery-broker": "\"$npm_node_execpath\" scripts/reject-direct-integrated-live-drill.js",
    "gate1:security": "\"$npm_node_execpath\" scripts/gate1-security.js",
    "gate1:temporal": "\"$npm_node_execpath\" scripts/gate1-temporal.js",
    "gate1:vector": "\"$npm_node_execpath\" scripts/gate1-vector.js",
    "test": "\"$npm_node_execpath\" --test test/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-apigatewayv2": "3.1098.0",
    "@aws-sdk/client-bedrock-runtime": "3.1098.0",
    "@aws-sdk/client-cloudformation": "3.1098.0",
    "@aws-sdk/client-iam": "3.1098.0",
    "@aws-sdk/client-kms": "3.1098.0",
    "@aws-sdk/client-lambda": "3.1098.0",
    "@aws-sdk/client-secrets-manager": "3.1098.0",
    "@aws-sdk/client-sts": "3.1098.0",
    "@smithy/node-http-handler": "4.9.13",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "axe-core": "4.12.1",
    "esbuild": "0.28.1"
  }
}
