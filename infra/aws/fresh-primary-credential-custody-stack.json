{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Create-only, operation-bound custody for seven empty ProofToAct fresh-primary credential containers and one short-lived chained writer. No secret value is present in this template.",
  "Parameters": {
    "BootstrapCreatorRoleArn": {
      "Type": "String",
      "Description": "Exact temporary non-root B0 role whose immutable IAM principal may assume the writer only while that B0 role exists.",
      "AllowedPattern": "^arn:aws:iam::[0-9]{12}:role/prooftoact/bootstrap/ProofToActBootstrapCreator-[0-9a-f]{16}$"
    },
    "CredentialSealExternalId": {
      "Type": "String",
      "Description": "Public source/operation/template-bound AssumeRole external identifier emitted by the reviewed preparer.",
      "AllowedPattern": "^[0-9a-f]{64}$"
    },
    "OperationId": {
      "Type": "String",
      "Description": "Exact approved fresh-primary operation UUID.",
      "AllowedPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "OperationToken": {
      "Type": "String",
      "Description": "First sixteen hexadecimal characters of the reviewed operation-token digest.",
      "AllowedPattern": "^[0-9a-f]{16}$"
    },
    "OperatorAuthorizationSha256": {
      "Type": "String",
      "Description": "SHA-256 of the explicit human operator authorization for this bounded credential custody ceremony.",
      "AllowedPattern": "^[0-9a-f]{64}$"
    },
    "SourceCommit": {
      "Type": "String",
      "Description": "Exact clean Git commit authorized to consume the sealed coordinates.",
      "AllowedPattern": "^[0-9a-f]{40}$"
    },
    "TemplateSha256": {
      "Type": "String",
      "Description": "SHA-256 of these exact reviewed template bytes.",
      "AllowedPattern": "^[0-9a-f]{64}$"
    },
    "TreeDigest": {
      "Type": "String",
      "Description": "Exact clean Git tree authorized to consume the sealed coordinates.",
      "AllowedPattern": "^[0-9a-f]{40}$"
    }
  },
  "Resources": {
    "FreshClusterAuditorSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "prooftoact/fresh-cluster/auditor",
        "Description": "Empty container for the exact CockroachDB Cloud auditor credential version used by one fresh-primary operation.",
        "Tags": [
          { "Key": "Project", "Value": "ProofToAct" },
          { "Key": "Purpose", "Value": "FreshClusterAuditor" },
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } }
        ]
      }
    },
    "FreshPrimaryCloudApiSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "prooftoact/fresh-primary/cloud-api",
        "Description": "Empty container for the exact CockroachDB Cloud creator credential version used by one fresh-primary operation.",
        "Tags": [
          { "Key": "Project", "Value": "ProofToAct" },
          { "Key": "Purpose", "Value": "FreshPrimaryCloudApi" },
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } }
        ]
      }
    },
    "FreshPrimaryRuntimeCredentialsSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "prooftoact/fresh-primary/runtime-credentials",
        "Description": "Empty container for the exact canonical CockroachDB runtime-credential bundle used by one fresh-primary operation.",
        "Tags": [
          { "Key": "Project", "Value": "ProofToAct" },
          { "Key": "Purpose", "Value": "FreshPrimaryRuntimeCredentials" },
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } }
        ]
      }
    },
    "ManagedMcpSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "prooftoact/gate2/managed-mcp",
        "Description": "Empty container for the exact read-only Managed MCP transport credential version used by one fresh-primary operation.",
        "Tags": [
          { "Key": "Project", "Value": "ProofToAct" },
          { "Key": "Purpose", "Value": "ManagedMcpReadOnly" },
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } }
        ]
      }
    },
    "RecoveryPublisherSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "prooftoact/gate2/recovery-publisher",
        "Description": "Empty container for the exact recovery-publisher credential version used by one fresh-primary operation.",
        "Tags": [
          { "Key": "Project", "Value": "ProofToAct" },
          { "Key": "Purpose", "Value": "RecoveryPublisher" },
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } }
        ]
      }
    },
    "FreshPrimaryAdminSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": { "Fn::Sub": "prooftoact/fresh-primary/admin-${OperationId}" },
        "Description": "Empty operation-bound target. The fresh-cluster runtime may seal exactly one bootstrap-admin version after provider creation.",
        "Tags": [
          { "Key": "Project", "Value": "ProofToAct" },
          { "Key": "Purpose", "Value": "FreshBootstrapAdmin" },
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } }
        ]
      }
    },
    "FreshPrimaryRecoverySignerSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": { "Fn::Sub": "prooftoact/fresh-primary/recovery-signer-${OperationId}" },
        "Description": "Empty operation-bound target. The fresh-primary runtime may seal exactly one P-256 recovery-signer version after database bootstrap.",
        "Tags": [
          { "Key": "Project", "Value": "ProofToAct" },
          { "Key": "Purpose", "Value": "FreshRecoveryPublisherSigner" },
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } }
        ]
      }
    },
    "FreshPrimaryCredentialWriterRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": { "Fn::Sub": "ProofToActFreshCredentialWriter-${OperationToken}" },
        "Path": "/prooftoact/bootstrap/",
        "Description": "Short-lived chained writer for exactly five immutable credential versions. The two operation-generated targets remain empty.",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "AWS": { "Ref": "BootstrapCreatorRoleArn" } },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": { "Ref": "CredentialSealExternalId" },
                  "sts:RoleSessionName": { "Fn::Sub": "prooftoact-credential-seal-${OperationToken}" }
                }
              }
            }
          ]
        },
        "ManagedPolicyArns": [],
        "Policies": [
          {
            "PolicyName": "ProofToActFreshCredentialSealOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "InspectExactSevenCredentialContainers",
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:DescribeSecret",
                    "secretsmanager:GetResourcePolicy",
                    "secretsmanager:ListSecretVersionIds"
                  ],
                  "Resource": [
                    { "Ref": "FreshClusterAuditorSecret" },
                    { "Ref": "FreshPrimaryCloudApiSecret" },
                    { "Ref": "FreshPrimaryRuntimeCredentialsSecret" },
                    { "Ref": "ManagedMcpSecret" },
                    { "Ref": "RecoveryPublisherSecret" },
                    { "Ref": "FreshPrimaryAdminSecret" },
                    { "Ref": "FreshPrimaryRecoverySignerSecret" }
                  ]
                },
                {
                  "Sid": "SealAndReadExactFiveCredentialVersions",
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue",
                    "secretsmanager:PutSecretValue"
                  ],
                  "Resource": [
                    { "Ref": "FreshClusterAuditorSecret" },
                    { "Ref": "FreshPrimaryCloudApiSecret" },
                    { "Ref": "FreshPrimaryRuntimeCredentialsSecret" },
                    { "Ref": "ManagedMcpSecret" },
                    { "Ref": "RecoveryPublisherSecret" }
                  ],
                  "Condition": {
                    "StringEquals": {
                      "secretsmanager:ResourceTag/Project": "ProofToAct",
                      "secretsmanager:ResourceTag/OperationId": { "Ref": "OperationId" }
                    }
                  }
                },
                {
                  "Sid": "DenyWritingAnyOtherSecret",
                  "Effect": "Deny",
                  "Action": "secretsmanager:PutSecretValue",
                  "NotResource": [
                    { "Ref": "FreshClusterAuditorSecret" },
                    { "Ref": "FreshPrimaryCloudApiSecret" },
                    { "Ref": "FreshPrimaryRuntimeCredentialsSecret" },
                    { "Ref": "ManagedMcpSecret" },
                    { "Ref": "RecoveryPublisherSecret" }
                  ]
                },
                {
                  "Sid": "DenySecretLifecycleMutation",
                  "Effect": "Deny",
                  "Action": [
                    "secretsmanager:CancelRotateSecret",
                    "secretsmanager:CreateSecret",
                    "secretsmanager:DeleteResourcePolicy",
                    "secretsmanager:DeleteSecret",
                    "secretsmanager:GetRandomPassword",
                    "secretsmanager:PutResourcePolicy",
                    "secretsmanager:RemoveRegionsFromReplication",
                    "secretsmanager:ReplicateSecretToRegions",
                    "secretsmanager:RestoreSecret",
                    "secretsmanager:RotateSecret",
                    "secretsmanager:StopReplicationToReplica",
                    "secretsmanager:TagResource",
                    "secretsmanager:UntagResource",
                    "secretsmanager:UpdateSecret",
                    "secretsmanager:UpdateSecretVersionStage"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "ReadOwnCallerIdentity",
                  "Effect": "Allow",
                  "Action": "sts:GetCallerIdentity",
                  "Resource": "*"
                },
                {
                  "Sid": "DenyUnrelatedProviderCapabilities",
                  "Effect": "Deny",
                  "Action": [
                    "apigateway:*",
                    "bedrock:*",
                    "cloudformation:*",
                    "dynamodb:*",
                    "execute-api:Invoke",
                    "iam:*",
                    "kms:*",
                    "lambda:*",
                    "s3:*",
                    "secretsmanager:BatchGetSecretValue",
                    "secretsmanager:ListSecrets",
                    "sts:AssumeRole"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ],
        "Tags": [
          { "Key": "Project", "Value": "ProofToAct" },
          { "Key": "Purpose", "Value": "FreshCredentialWriter" },
          { "Key": "OperationId", "Value": { "Ref": "OperationId" } },
          { "Key": "OperatorAuthorizationSha256", "Value": { "Ref": "OperatorAuthorizationSha256" } },
          { "Key": "SourceCommit", "Value": { "Ref": "SourceCommit" } },
          { "Key": "TreeDigest", "Value": { "Ref": "TreeDigest" } },
          { "Key": "TemplateSha256", "Value": { "Ref": "TemplateSha256" } }
        ]
      }
    }
  },
  "Outputs": {
    "AdminSecretArn": { "Value": { "Ref": "FreshPrimaryAdminSecret" } },
    "AuditorSecretArn": { "Value": { "Ref": "FreshClusterAuditorSecret" } },
    "CloudApiSecretArn": { "Value": { "Ref": "FreshPrimaryCloudApiSecret" } },
    "ManagedMcpSecretArn": { "Value": { "Ref": "ManagedMcpSecret" } },
    "RecoveryPublisherSecretArn": { "Value": { "Ref": "RecoveryPublisherSecret" } },
    "RuntimeCredentialsSecretArn": { "Value": { "Ref": "FreshPrimaryRuntimeCredentialsSecret" } },
    "SignerSecretArn": { "Value": { "Ref": "FreshPrimaryRecoverySignerSecret" } },
    "WriterRoleArn": { "Value": { "Fn::GetAtt": ["FreshPrimaryCredentialWriterRole", "Arn"] } }
  }
}
